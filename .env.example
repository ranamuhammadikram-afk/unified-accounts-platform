# Copy this file to ".env" in the same folder and fill in real values before
# running `docker compose up`. Never commit the real ".env" to git.

# --- Database ---
POSTGRES_DB=uap
POSTGRES_USER=uap
POSTGRES_PASSWORD=change-this-to-a-strong-password
POSTGRES_PORT=5432

# --- Backend API ---
# Generate a real secret with:  openssl rand -base64 48
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=12h
BACKEND_PORT=4000
# The public URL(s) of your frontend, comma-separated. Must match exactly
# (including http/https and port) or the browser will block API requests.
# Example for a VPS with a domain:  CORS_ORIGIN=https://accounts.yourcompany.com
CORS_ORIGIN=http://localhost:8080

# --- Frontend ---
FRONTEND_PORT=8080
# The URL the USER'S BROWSER will use to reach the backend API.
# Example for a VPS with a domain:  VITE_API_URL=https://api.yourcompany.com
VITE_API_URL=http://localhost:4000
