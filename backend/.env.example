# Copy this file to ".env" in the same folder before running docker compose,
# or set these values as real environment variables in your hosting platform.

DATABASE_URL=postgres://uap:changeme@localhost:5432/uap
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=12h
PORT=4000
CORS_ORIGIN=http://localhost:8080

# Dropbox credentials for the nightly automatic database backup (~02:00 Asia/Riyadh).
# Create an app at https://www.dropbox.com/developers/apps ("Scoped access", Full Dropbox),
# enable the files.content.write permission, then get:
#   - App key / App secret from the app's Settings tab
#   - A refresh token via the one-time OAuth authorization flow (does not expire)
# Leave these unset to disable the nightly backup (the app runs fine without them).
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=

# Dropbox folder the nightly backup JSON files are written to (created automatically).
DROPBOX_BACKUP_FOLDER=/Unified Accounts Platform Backups

# Shared secret that lets an external scheduler (the GitHub Actions workflow in
# .github/workflows/nightly-backup.yml) trigger POST /api/backup/cron without a logged-in
# session. Needed because Render's free tier spins down on inactivity, which silently kills
# the in-process nightly timer above — the external cron call both wakes the service up and
# runs the backup. Set this to a long random string, and use the SAME value as the
# BACKUP_CRON_SECRET repository secret in GitHub (Settings > Secrets and variables > Actions).
BACKUP_CRON_SECRET=
