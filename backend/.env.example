# Copy this file to ".env" in the same folder before running docker compose,
# or set these values as real environment variables in your hosting platform.

DATABASE_URL=postgres://uap:changeme@localhost:5432/uap
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=12h
PORT=4000
CORS_ORIGIN=http://localhost:8080

# Dropbox access token used for the nightly automatic database backup (~02:00 Asia/Riyadh).
# Create an app at https://www.dropbox.com/developers/apps, give it the files.content.write
# scope, and generate an access token from the app's settings page. Leave unset to disable
# the nightly backup (the app runs fine without it).
DROPBOX_ACCESS_TOKEN=

# Dropbox folder the nightly backup JSON files are written to (created automatically).
DROPBOX_BACKUP_FOLDER=/Unified Accounts Platform Backups
