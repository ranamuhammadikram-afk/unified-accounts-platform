# Copy this file to ".env" in the same folder before running docker compose,
# or set these values as real environment variables in your hosting platform.

DATABASE_URL=postgres://uap:changeme@localhost:5432/uap
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=12h
PORT=4000
CORS_ORIGIN=http://localhost:8080

# Oracle Cloud (OCI) Object Storage target for the nightly automatic database backup
# (~02:00 Asia/Riyadh). Backups go to a shared bucket (e.g. "erp-backups") that can hold
# several applications, each in its own folder. Create, in the OCI console:
#   Storage > Buckets > erp-backups > Pre-Authenticated Requests > Create
#     - Target: "Objects with prefix", prefix: unified-accounts-platform/
#     - Access type: "Permit object writes" (write-only)
#     - Expiration: a date several years ahead
# and paste the generated URL here. Treat it as a secret. Leave unset to disable backups.
OCI_BACKUP_PAR_URL=

# Folder (object-name prefix) inside the bucket for this app's backups.
OCI_BACKUP_PREFIX=unified-accounts-platform/

# Shared secret that lets an external scheduler (the GitHub Actions workflow in
# .github/workflows/nightly-backup.yml) trigger POST /api/backup/cron without a logged-in
# session. Needed because Render's free tier spins down on inactivity, which silently kills
# the in-process nightly timer above — the external cron call both wakes the service up and
# runs the backup. Set this to a long random string, and use the SAME value as the
# BACKUP_CRON_SECRET repository secret in GitHub (Settings > Secrets and variables > Actions).
BACKUP_CRON_SECRET=
